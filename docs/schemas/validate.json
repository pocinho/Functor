{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functor validate",
  "description": "Output of `functor validate --output json` (docs/cli-spec.md, docs/validation-rules.md). The document has no timestamp, so the same repository always produces the same bytes. Findings are ordered by code, subject, message.",
  "type": "object",
  "required": ["schema_version", "outcome", "strict", "counts", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "outcome": { "enum": ["passed", "warning", "failed", "unknown"] },
    "strict": { "type": "boolean" },
    "counts": {
      "type": "object",
      "required": ["artifacts", "relationships", "errors", "warnings", "infos"],
      "additionalProperties": false,
      "properties": {
        "artifacts": { "type": "integer", "minimum": 0 },
        "relationships": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } }
  },
  "$defs": {
    "Finding": {
      "type": "object",
      "required": ["code", "severity", "subject", "message", "related"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^V[0-9]{4}$" },
        "severity": { "enum": ["error", "warning", "info"] },
        "subject": { "$ref": "#/$defs/Subject" },
        "message": { "type": "string", "minLength": 1 },
        "related": { "type": "array", "items": { "$ref": "#/$defs/Subject" } }
      }
    },
    "Subject": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "repository" } }
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "artifact" },
            "id": { "type": "string", "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "relationship" },
            "id": { "type": "string", "pattern": "^rel_[0-9A-HJKMNP-TV-Z]{26}$" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "path"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "file" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
