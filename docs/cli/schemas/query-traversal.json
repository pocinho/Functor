{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functor query dependencies, dependents",
  "description": "Output of `functor query dependencies|dependents --output json` (docs/cli/cli-spec.md). `nodes` are ordered by depth, slug, id and exclude the start; `edges` are ordered by relationship id. The Artifact, Endpoint and Relationship definitions are identical to those in artifact-list.json and relationship-list.json; a test keeps them in sync.",
  "type": "object",
  "required": ["schema_version", "start", "direction", "relationship_types", "max_depth", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "start": { "$ref": "#/$defs/Endpoint" },
    "direction": { "enum": ["outbound", "inbound"] },
    "relationship_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
    },
    "max_depth": { "type": ["integer", "null"], "minimum": 0 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["depth", "artifact", "via"],
        "additionalProperties": false,
        "properties": {
          "depth": { "type": "integer", "minimum": 1 },
          "artifact": { "$ref": "#/$defs/Artifact" },
          "via": { "$ref": "#/$defs/Relationship" }
        }
      }
    },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/Relationship" } }
  },
  "$defs": {
    "Artifact": {
      "type": "object",
      "required": [
        "id", "ref", "slug", "type", "title", "revision", "description", "tags", "metadata",
        "content", "created", "updated"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$" },
        "ref": { "type": "string", "pattern": "^functor:artifact:art_[0-9A-HJKMNP-TV-Z]{26}$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "revision": { "type": "integer", "minimum": 1 },
        "description": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$" },
          "uniqueItems": true
        },
        "metadata": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$" },
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "integer" },
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        },
        "content": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["format"],
              "additionalProperties": false,
              "properties": {
                "format": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.+-]{0,31}$" },
                "text": { "type": "string" },
                "path": { "type": "string", "minLength": 1 }
              },
              "anyOf": [{ "required": ["text"] }, { "required": ["path"] }]
            }
          ]
        },
        "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    },
    "Endpoint": {
      "type": "object",
      "required": ["id", "slug"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 }
      }
    },
    "Relationship": {
      "type": "object",
      "required": ["id", "ref", "type", "source", "target", "created", "metadata"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^rel_[0-9A-HJKMNP-TV-Z]{26}$" },
        "ref": { "type": "string", "pattern": "^functor:relationship:rel_[0-9A-HJKMNP-TV-Z]{26}$" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "source": { "$ref": "#/$defs/Endpoint" },
        "target": { "$ref": "#/$defs/Endpoint" },
        "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "metadata": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$" },
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "integer" },
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    }
  }
}
