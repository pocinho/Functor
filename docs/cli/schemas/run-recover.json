{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "functor run recover",
  "type": "object",
  "required": ["schema_version", "runs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "runs": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "run-show.json#/$defs/Run" },
          { "properties": { "state": { "const": "interrupted" }, "streams": { "type": "null" } } }
        ]
      }
    }
  }
}
