<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Services\AvaloniaClipboardService.fs" />
    <Compile Include="Services\AvaloniaDialogService.fs" />
    <Compile Include="Rendering\RenderingSurface.fs" />
    <Compile Include="Rendering\AvaloniaRenderBackend.fs" />
    <Compile Include="Controls\EditorControl.fs" />
    <Compile Include="ViewModels\ViewModelBase.fs" />
    <Compile Include="ViewModels\MainViewModel.fs" />
    <Compile Include="ViewModels\CommandPaletteViewModel.fs" />
    <Compile Include="ViewModels\SettingsViewModel.fs" />
    <Compile Include="ViewModels\ShellViewModel.fs" />
    <Compile Include="Views\CommandPaletteView.axaml.fs" />
    <Compile Include="Views\SettingsView.axaml.fs" />
    <Compile Include="Views\SettingsWindow.axaml.fs" />
    <Compile Include="Views\WelcomeView.axaml.fs" />
    <Compile Include="Views\MainView.axaml.fs" />
    <Compile Include="Views\MainWindow.axaml.fs" />
    <Compile Include="AvaloniaApp.axaml.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Functor.Application\Functor.Application.fsproj" />
    <ProjectReference Include="..\Functor.Domain\Functor.Domain.fsproj" />
    <ProjectReference Include="..\Functor.Platform\Functor.Platform.fsproj" />
    <ProjectReference Include="..\Functor.Rendering\Functor.Rendering.fsproj" />
  </ItemGroup>
</Project>
