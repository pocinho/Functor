<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Functor.Avalonia.Controls"
             xmlns:views="using:Functor.Avalonia.Views"
             x:Class="Functor.Avalonia.Views.ShellHostView">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Border x:Name="TabBar"
                    Grid.Row="0"
                    Grid.Column="2"
                    Grid.ColumnSpan="3"
                    BorderThickness="0,0,0,1"
                    Padding="4,3">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Hidden">
                    <controls:DocumentListView x:Name="TabsPanel" />
                </ScrollViewer>
            </Border>
            <Border x:Name="ToolRail"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Padding="3"
                    BorderThickness="0,0,1,0">
                <StackPanel Spacing="4">
                    <Button x:Name="WorkspaceToolButton" Content="W" ToolTip.Tip="Workspace" />
                    <Button x:Name="SearchToolButton" Content="S" ToolTip.Tip="Search" />
                </StackPanel>
            </Border>
            <controls:SidePanelControl x:Name="SidePanelHost"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    PanelWidth="0"
                                    IsOpen="False"
                                    IsResizable="True" />
            <controls:EditorControl x:Name="EditorControl"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Focusable="True" />
            <views:WelcomeView x:Name="WelcomeView"
                              Grid.Row="1"
                              Grid.Column="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsVisible="False" />
                     <controls:SidePanelControl x:Name="AuxiliaryPanelHost"
                                 Grid.Row="1"
                                 Grid.Column="3"
                                 PanelWidth="0"
                                 IsOpen="False" />
            <ScrollBar x:Name="VerticalScrollBar"
                              Grid.Row="1"
                              Grid.Column="4"
                       Orientation="Vertical"
                       Minimum="0"
                       Maximum="0"
                       ViewportSize="1"
                       IsEnabled="False" />
            <ScrollBar x:Name="HorizontalScrollBar"
                       Grid.Row="2"
                       Grid.Column="2"
                       Orientation="Horizontal"
                       Minimum="0"
                       Maximum="0"
                       ViewportSize="1"
                       IsEnabled="False" />
            <Border x:Name="StatusBar"
                    Grid.Row="3"
                    Grid.ColumnSpan="5"
                    BorderThickness="0,1,0,0"
                    Padding="8,4">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock x:Name="PositionText" Grid.Column="0" />
                    <TextBlock x:Name="FileTypeText" Grid.Column="1" Margin="20,0,0,0" />
                    <TextBlock x:Name="MessageText" Grid.Column="2" Margin="20,0,0,0" />
                    <TextBlock x:Name="FileNameText" Grid.Column="3" Margin="20,0,0,0" />
                    <TextBlock x:Name="DirtyText" Grid.Column="4" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>