<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Functor.Avalonia.Controls"
             xmlns:views="using:Functor.Avalonia.Views"
             x:Class="Functor.Avalonia.Views.ShellHostView"
             Background="{DynamicResource Theme.SurfaceBackground}"
             Foreground="{DynamicResource Theme.TextPrimary}">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto">
            <Border x:Name="TabBar"
                    Grid.Row="0"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                        BorderThickness="{DynamicResource Theme.SeparatorBottomThickness}"
                        Padding="{DynamicResource Theme.TabBarPadding}"
                        Background="{DynamicResource Theme.PanelBackground}"
                        BorderBrush="{DynamicResource Theme.Border}">
                <Grid ColumnDefinitions="*,Auto">
                    <controls:DocumentListView x:Name="TabsPanel" Grid.Column="0" HorizontalAlignment="Stretch" />
                    <Button x:Name="SettingsTabButton"
                            Grid.Column="1"
                            Content="Settings"
                            IsVisible="False"
                            Padding="{DynamicResource Theme.DocumentTabPadding}"
                            MinHeight="{DynamicResource Theme.DocumentTabMinHeight}"
                            Background="{DynamicResource Theme.PanelBackground}"
                            BorderBrush="{DynamicResource Theme.Border}"
                            Foreground="{DynamicResource Theme.TextPrimary}" />
                </Grid>
            </Border>
            <Border x:Name="ToolRail"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Padding="{DynamicResource Theme.ToolRailPadding}"
                    BorderThickness="{DynamicResource Theme.SeparatorRightThickness}"
                    Background="{DynamicResource Theme.PanelBackground}"
                    BorderBrush="{DynamicResource Theme.Border}">
                <StackPanel Spacing="{DynamicResource Theme.ToolRailSpacing}">
                    <Button x:Name="WorkspaceToolButton" Content="W" ToolTip.Tip="Workspace" />
                    <Button x:Name="SearchToolButton" Content="S" ToolTip.Tip="Search" />
                </StackPanel>
            </Border>
            <controls:SidePanelControl x:Name="SidePanelHost"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    PanelWidth="0"
                                    IsOpen="False"
                                    IsResizable="True" />
            <controls:EditorControl x:Name="EditorControl"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Focusable="True" />
            <views:WelcomeView x:Name="WelcomeView"
                              Grid.Row="1"
                              Grid.Column="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsVisible="False" />
            <Grid x:Name="SettingsDocument"
                  Grid.Row="1"
                  Grid.Column="2"
                  IsVisible="False"
                  RowDefinitions="*,Auto">
                <views:SettingsView x:Name="SettingsView" Grid.Row="0" />
                <Border x:Name="SettingsFooter"
                    Grid.Row="1"
                    BorderThickness="{DynamicResource Theme.SeparatorTopThickness}"
                    Padding="{DynamicResource Theme.SettingsFooterPadding}"
                    BorderBrush="{DynamicResource Theme.Border}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Theme.SettingsFooterSpacing}">
                        <Button x:Name="ApplySettingsButton" Content="Apply" />
                        <Button x:Name="SaveSettingsButton" Content="Save" />
                        <Button x:Name="ExportThemeButton" Content="Export theme" />
                        <Button x:Name="CloseSettingsButton" Content="Close" />
                    </StackPanel>
                </Border>
            </Grid>
                     <controls:SidePanelControl x:Name="AuxiliaryPanelHost"
                                 Grid.Row="1"
                                 Grid.Column="3"
                                 PanelWidth="0"
                                 IsOpen="False" />
            <Border x:Name="StatusBar"
                    Grid.Row="3"
                    Grid.ColumnSpan="4"
                    BorderThickness="{DynamicResource Theme.SeparatorTopThickness}"
                    Padding="{DynamicResource Theme.StatusBarPadding}"
                    Background="{DynamicResource Theme.PanelBackground}"
                    BorderBrush="{DynamicResource Theme.Border}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock x:Name="PositionText" Grid.Column="0" />
                    <TextBlock x:Name="FileTypeText" Grid.Column="1" Margin="{DynamicResource Theme.StatusTextGap}" />
                    <TextBlock x:Name="MessageText" Grid.Column="2" Margin="{DynamicResource Theme.StatusTextGap}" />
                    <TextBlock x:Name="FileNameText" Grid.Column="3" Margin="{DynamicResource Theme.StatusTextGap}" />
                    <TextBlock x:Name="DirtyText" Grid.Column="4" Margin="{DynamicResource Theme.StatusDirtyGap}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>