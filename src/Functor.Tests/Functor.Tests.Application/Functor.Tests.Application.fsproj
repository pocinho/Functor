<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ThemeSettingsLoaderTests.fs" />
    <Compile Include="AppCommandCatalogTests.fs" />
    <Compile Include="EditorStatusTests.fs" />
