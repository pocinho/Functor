<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ShellModelTests.fs" />
    <Compile Include="ShellProjectionTests.fs" />
    <Compile Include="ShellViewNodeTests.fs" />
    <Compile Include="ShellViewTests.fs" />
    <Compile Include="ShellHostViewTests.fs" />
    <Compile Include="ShellHostViewProjectionTests.fs" />
    <Compile Include="WorkspaceTreeCoordinatorTests.fs" />
    <Compile Include="MainWindowTests.fs" />
    <Compile Include="EditorControlTests.fs" />
    <Compile Include="InputAdapterTests.fs" />
    <Compile Include="SettingsCoordinatorTests.fs" />
    <Compile Include="SettingsViewTests.fs" />
    <Compile Include="CommandPaletteViewTests.fs" />
    <Compile Include="SearchPanelControlTests.fs" />
    <ProjectReference Include="..\..\Functor.Avalonia\Functor.Avalonia.fsproj" />
    <ProjectReference Include="..\..\Functor.Application\Functor.Application.fsproj" />
    <ProjectReference Include="..\..\Functor.Syntax\Functor.Syntax.fsproj" />
    <ProjectReference Include="..\..\Functor.Input\Functor.Input.fsproj" />
    <ProjectReference Include="..\..\Functor.Workspace\Functor.Workspace.fsproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
