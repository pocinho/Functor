{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Functor",
  "version": "0.1.0",
  "identifier": "dev.functor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../out/functor_web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Functor",
        "width": 960,
        "height": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
